# Copy to .env and edit. With defaults (provider=offline) the app runs with no
# keys and no network — ideal for a first run and for CI.

FINRAG_PROVIDER=offline          # offline | openai | azure | anthropic

# --- OpenAI ---
# FINRAG_PROVIDER=openai
# FINRAG_OPENAI_API_KEY=sk-...
# FINRAG_LLM_MODEL=gpt-4o-mini
# FINRAG_EMBEDDING_MODEL=text-embedding-3-small

# --- Azure OpenAI (matches Cognizant's Azure AI Foundry stack) ---
# FINRAG_PROVIDER=azure
# FINRAG_AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# FINRAG_AZURE_OPENAI_API_KEY=...
# FINRAG_LLM_MODEL=<your-deployment-name>

# --- Postgres + pgvector (production retrieval backend) ---
# FINRAG_USE_PGVECTOR=true
# FINRAG_DATABASE_URL=postgresql+psycopg://finrag:finrag@postgres:5432/finrag

# --- retrieval / guardrail tuning ---
FINRAG_TOP_K_FINAL=5
FINRAG_MIN_GROUNDEDNESS=0.70
FINRAG_MAX_SELF_CORRECTIONS=1
